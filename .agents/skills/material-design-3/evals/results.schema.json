{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deserveto/Material-Design-Kit-3-Skills/evals/results.schema.json",
  "title": "Material Design 3 Skill behavioral eval results",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["case_id", "fixture_id", "harness", "harness_version", "model", "reasoning_setting", "date", "skill_commit", "condition", "skill_loaded", "required_passed", "required_total", "forbidden_observed", "forbidden_total", "notes"],
    "properties": {
      "case_id": {"type": "string"},
      "fixture_id": {"type": "string"},
      "harness": {"type": "string"},
      "harness_version": {"type": "string"},
      "model": {"type": "string"},
      "reasoning_setting": {"type": "string"},
      "date": {"type": "string", "format": "date"},
      "skill_commit": {"type": "string"},
      "condition": {"enum": ["without-skill", "with-skill"]},
      "skill_loaded": {"type": "boolean"},
      "required_passed": {"type": "integer", "minimum": 0},
      "required_total": {"type": "integer", "minimum": 1},
      "forbidden_observed": {"type": "integer", "minimum": 0},
      "forbidden_total": {"type": "integer", "minimum": 1},
      "dependency_claims_valid": {"type": "boolean"},
      "catastrophic_failure": {"type": "boolean"},
      "output_artifact": {"type": "string"},
      "notes": {"type": "string"}
    },
    "additionalProperties": false
  }
}
